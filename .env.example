# Environment & Debug
ENVIRONMENT=development
DEBUG=true

# Security (Change in production!)
SECRET_KEY=change-this-to-a-very-long-and-secure-random-secret-key-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL)
# Local development default: sqlite+aiosqlite:///./avom_dev.db
# Docker compose default: postgresql+asyncpg://postgres:postgres@localhost:5432/avom
DATABASE_URL=sqlite+aiosqlite:///./avom_dev.db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=avom
POSTGRES_PORT=5432

# Redis Cache & Celery Broker
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Qdrant Vector Store
# Local development: leave blank to run in-memory / local SQLite vector simulation
# Docker compose default: http://localhost:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# LLM Providers (Required for Generation & LLM-as-a-judge)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
